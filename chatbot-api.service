[Unit]
Description=Portfolio Agent Chatbot FastAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/chatbot
EnvironmentFile=/root/chatbot/chatbot.env
ExecStart=/root/chatbot/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8002 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
