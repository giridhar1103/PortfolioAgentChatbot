# Copy to: /etc/nginx/sites-available/chat-api.your-domain.com
# Symlink:  ln -s /etc/nginx/sites-available/chat-api.your-domain.com /etc/nginx/sites-enabled/
# SSL:      certbot --nginx -d chat-api.your-domain.com
# Reload:   nginx -t && systemctl reload nginx

server {
    server_name chat-api.your-domain.com;

    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        limit_req zone=api_per_ip burst=10 nodelay;
        limit_conn api_conn_per_ip 5;

        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE-specific: disable buffering so tokens stream to the client immediately
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 5s;

        limit_req_status 429;
    }

    # Certbot will add SSL block below
}
